# API do Supabase atras da Cloudflare (api.ride.dev.br).
#
# Existe para tirar a API de exposicao direta: o hostname antigo
# (srv1689008.hstgr.cloud) publica o IP da VPS e nao passa pela Cloudflare,
# entao nao tem WAF, nem anti-DDoS, nem limite de tentativas de login.
#
# O map $connection_upgrade ja e definido no vhost 'supabase' — nao repetir.
server {
    listen 80;
    listen 443 ssl;
    server_name api.ride.dev.br;

    ssl_certificate     /etc/letsencrypt/live/api.ride.dev.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.ride.dev.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 50m;

    # Desafio do Lets Encrypt para api.ride.dev.br. Precisa estar aqui
    # tambem porque a Cloudflare fala com a origem em 443, e ate o certificado
    # existir o pedido cai neste vhost (o padrao).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }


    # Login com senha (renovacao de sessao NAO conta — ver auth-ratelimit.conf)
    location = /auth/v1/token {
        limit_req zone=auth_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Cadastro, recuperacao de senha e conferencia de codigo de 6 digitos.
    location ~ ^/auth/v1/(signup|recover|verify|otp)$ {
        limit_req zone=auth_codes burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;   # realtime: websocket de longa duracao
        proxy_send_timeout 3600s;
    }
}
